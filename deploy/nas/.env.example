# Neben compose.yaml als .env ablegen (nicht ins Repository!), chmod 600

# Hauptadresse der Mining-Wallet (95 Zeichen, beginnt mit 4) – Auszahlungsadresse für P2Pool
XMR_ADDRESS=4...

# Ledger-Image aus GitHub Container Registry; Version bewusst festlegen (siehe docs/de/operations.md; EN: docs/en/operations.md)
LEDGER_IMAGE=ghcr.io/nexovaanalytics-oss/xmr-ledger
LEDGER_VERSION=1.1.0
